{
  "openapi": "3.1.0",
  "info": {
    "title": "多端论坛投稿接口",
    "version": "1.0.0",
    "description": "个人密钥投稿，沿用账号审核设置；管理员开启账号免审后直接发布。第一版只接收文字与 Markdown。密钥仅限服务端使用。每分钟20次、24小时100篇。"
  },
  "servers": [
    {
      "url": "/api/open/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "aic_ personal API key"
      }
    }
  },
  "paths": {
    "/taxonomy": {
      "get": {
        "operationId": "getPostingTaxonomy",
        "summary": "获取分类、标签及部门",
        "responses": {
          "200": {
            "description": "可用的投稿选项",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "departments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts": {
      "post": {
        "operationId": "submitCommunityPost",
        "summary": "提交本人内容，按账号审核设置发布",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "同一篇内容重试使用同一键，新篇使用新键；同键异内容返回409",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "body", "categoryId"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["experience", "project", "prompt", "discussion"],
                    "default": "experience"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150000,
                    "description": "Markdown 正文；提示词类型最多100000字符，保存为提示词正文"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 400
                  },
                  "categoryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "tags": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "maxLength": 30
                    }
                  },
                  "visibility": {
                    "type": "string",
                    "enum": ["company", "departments"],
                    "default": "company"
                  },
                  "departments": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["discussion", "question", "feedback", "chat"],
                    "default": "discussion"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "已提交；需审核账号返回 queued，免审账号直接返回 published",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "status", "url", "reason"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "review",
                        "draft",
                        "approved",
                        "published",
                        "rejected",
                        "withdrawn"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "同一幂等键返回原投稿",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "status", "url", "reason"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "review",
                        "draft",
                        "approved",
                        "published",
                        "rejected",
                        "withdrawn"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "operationId": "getOwnSubmissionStatus",
        "summary": "查询本人的接口投稿状态",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前投稿状态及地址",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "status", "url", "reason"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "review",
                        "draft",
                        "approved",
                        "published",
                        "rejected",
                        "withdrawn"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "请求未成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
