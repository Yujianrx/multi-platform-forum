{
  "name": "multi-platform-forum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.server.json && node dist/server/main.js",
    "build": "node scripts/optimize-brand-assets.mjs && tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "assets:optimize": "node scripts/optimize-brand-assets.mjs",
    "start": "node dist/server/main.js",
    "db:migrate": "tsc -p tsconfig.server.json && node dist/server/cli.js migrate",
    "admin:init": "tsc -p tsconfig.server.json && node dist/server/cli.js admin",
    "seed": "tsc -p tsconfig.server.json && node dist/server/cli.js seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.10",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "file-type": "22.3.0",
    "lucide-react": "1.72.0",
    "marked": "17.0.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
