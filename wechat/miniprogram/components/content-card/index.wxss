.card { overflow: hidden; min-width: 0; border-radius: 11px; background: #fff; }
.pressed { opacity: .78; }
.cover { position: relative; aspect-ratio: 4/5; background: #f1e4d1; color: #63462c; overflow: hidden; }
.cover.project { background: #e5ece6; color: #315b4b; }
.cover.skill { background: #ede8f0; color: #59475f; }
.cover.prompt { background: #f7e2e2; color: #793c47; }
.cover.discussion { background: #f4eae4; color: #725444; }
.cover-words { position: absolute; inset: 16px 13px; display: flex; flex-direction: column; }
.cover-words text { display: block; margin: 0 0 10px; font-size: 12px; font-weight: 650; }
.cover-words view { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow-wrap: anywhere; font-size: 21px; font-weight: 750; line-height: 1.35; }
.cover-words .category { margin: auto 0 0; padding-top: 4px; font-weight: 400; opacity: .78; }
.cover-image { position: absolute; inset: 0; }
.badge { position: absolute; top: 7px; right: 7px; padding: 3px 7px; border-radius: 6px; background: #fff; color: #a9263a; font-size: 11px; }
.card-foot { padding: 9px 9px 10px; }
.card-title { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; height: 40px; color: #3f3238; font-size: 14px; font-weight: 670; line-height: 20px; }
.card-summary { font-weight: 400; }
.author { display: flex; align-items: center; gap: 5px; margin-top: 7px; color: #74636d; font-size: 11px; }
.initial { display: grid; flex: none; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: #f3e4e5; color: #91525a; font-size: 9px; font-weight: 700; }
.name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.likes { flex: none; }
@media (max-width: 350px) { .cover-words { inset: 11px; } .cover-words view { font-size: 17px; } }
