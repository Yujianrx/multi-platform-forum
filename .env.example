NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Empty = development-only embedded PostgreSQL. Production requires DATABASE_URL.
DATABASE_URL=
DATA_DIR=./data
# none = manual review; development = deterministic development simulator
MODERATION_PROVIDER=none
# Optional local ClamAV daemon (never a client supplied host).
CLAMAV_HOST=
CLAMAV_PORT=3310
TRUST_PROXY=false
